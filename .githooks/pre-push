#!/bin/sh
# Runs what CI runs (npm run check: the CPU probes, then the browser probes on
# this Mac's GPU) before a push leaves the machine, so a failing check is found
# here and not after the push. npm install points git at this folder
# (package.json's prepare); `git config core.hooksPath .githooks` does too.
#
# It checks the working tree, so it pushes only HEAD, committed: a push of
# another branch, or with uncommitted changes, is stopped before anything
# runs. Deleting a remote branch runs nothing. `git push --no-verify` skips
# the check: keep that for a push CI does not check (no code changed).

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushes_code=no
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit; check it out and push from there, so the check runs on what is pushed." >&2
    exit 1
  fi
  pushes_code=yes
done
[ "$pushes_code" = no ] && exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes would be checked in place of the pushed commit; commit or stash them first." >&2
  exit 1
fi

echo "pre-push: npm run check (what CI runs; git push --no-verify skips it)" >&2
exec npm run check
